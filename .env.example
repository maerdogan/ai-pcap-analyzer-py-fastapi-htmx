PCAP_ANALYZER_ADMIN_USER=admin
# Set one of these. Create a hash with: pcap-analyzer hash-password
PCAP_ANALYZER_ADMIN_PASSWORD=
# PCAP_ANALYZER_ADMIN_PASSWORD_HASH=
# Set to 1 when an HTTPS proxy is in front of port 8000.
PCAP_ANALYZER_BEHIND_PROXY=1
# Proxy addresses or networks whose forwarded headers are believed.
# PCAP_ANALYZER_TRUSTED_PROXIES=10.0.0.5
PCAP_ANALYZER_MAX_SIZE_MB=100
PCAP_ANALYZER_TTL_DAYS=7
PCAP_ANALYZER_MAX_JOBS=2
PCAP_ANALYZER_KEEP_CAPTURE=1
